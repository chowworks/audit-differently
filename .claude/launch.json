{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:3100",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@ad/web",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3100",
        "FRONTEND_URL=http://localhost:5273",
        "npm",
        "run",
        "dev",
        "--workspace",
        "@ad/api"
      ],
      "port": 3100
    }
  ]
}
