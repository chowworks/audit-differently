PORT=3000
FRONTEND_URL=http://localhost:5173

# There is no local database and no demo sign-in: a laptop develops against the shared `dev` environment on
# Railway (fictional seed data only) and signs in through the dev Clerk instance, exactly as the deployed API
# does (docs/dev-api.md). Both URLs come from Railway (`railway variables -s Postgres -e dev`, the public
# DATABASE_PUBLIC_URL host) and must carry sslmode=require: the API refuses a database off this machine
# without TLS (src/startup-checks.ts).
#
# DATABASE_URL is the restricted role the API connects as (scripts/create-app-role.ts prints it; never the owner
# or a superuser), and SCHEMA_DATABASE_URL is the owner, for Prisma's CLI, the seed and the scripts
# (CLAUDE.md, "Tenant isolation").
DATABASE_URL=postgresql://ad_app:<password>@<dev postgres public host>:<port>/railway?sslmode=require
SCHEMA_DATABASE_URL=postgresql://postgres:<password>@<dev postgres public host>:<port>/railway?sslmode=require
# What role:create gives the restricted role (24+ characters); needed only when you run that script.
# APP_ROLE_PASSWORD=

# Every environment runs with row-level security: the API refuses to start as a role that bypasses it.
REQUIRE_TENANT_RLS=on

# This product's own Clerk instance: the dev instance's sk_test_ key here, never a live key and never a key from
# Interview Differently or Learn Differently.
CLERK_SECRET_KEY=sk_test_replace_me

# Private document bucket (Cloudflare R2, S3 API): the dev bucket locally. Unset, documents go to
# apps/api/storage/ on this disk, which a deployed API refuses (src/startup-checks.ts).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_DOCUMENTS_BUCKET=

# Behind Railway's proxy set TRUST_PROXY=1 so req.ip is the client (set by .railway/railway.ts, not here).

# The public contact form (POST /api/contact) sends through Resend's HTTP API. Unset, the form answers 503
# "not available". CONTACT_FROM_EMAIL must be on a domain verified in Resend; CONTACT_TO_EMAIL defaults to
# info@auditdifferently.tech.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=

# Import transactions: with a key, the first guess at a file's column mapping comes from Claude, sent the column
# names alone (never a row of the file). Unset, the guess comes from the column names; the person confirms either way.
# ANTHROPIC_API_KEY=

# Email in receipts (POST /api/inbound/resend, the receipts inbox on the workspace page): Resend inbound, on the
# receipts subdomain. Off and harmless until all three are set (the webhook answers 404 and no worker runs); on Railway
# the API refuses to start with only some of them. RESEND_RECEIVING_API_KEY is its own Resend key with Full access
# (reading a received email needs it; the contact form keeps its sending-only RESEND_API_KEY); RESEND_WEBHOOK_SECRET is the webhook's signing secret (whsec_...); RECEIPTS_DOMAIN is the
# subdomain the receipts addresses are on, with its MX record pointing at Resend. No email is ever sent from this flow.
# RESEND_RECEIVING_API_KEY=
# RESEND_WEBHOOK_SECRET=
# RECEIPTS_DOMAIN=
