generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // The owner connection for Prisma's CLI (migrate deploy), the seed and scripts. DATABASE_URL is the API's
  // connection: the restricted role that row-level security binds (CLAUDE.md, "Tenant isolation").
  directUrl = env("SCHEMA_DATABASE_URL")
}

// ── Tenancy ─────────────────────────────────────────────────────────────────
// The workspace is the tenant: a team's container for the engagements (grants, contracts) it accounts for.
// Postgres row-level security draws one line (docs/tenant-isolation.md): a person sees the rows of the
// workspaces they belong to and nothing else. Every row of engagement, report, expense, document, participant
// or check data carries `workspaceId`. Where a comment says "set by trigger" the column is optional here
// (Prisma need not supply it) and NOT NULL in the database: the trigger copies it from the parent row and
// refuses a row without one. The funder (a state agency, a board) is a name on the engagement, not an actor.

model Workspace {
  id                        String           @id @default(uuid())
  /// The full demo workspace: fictional data that shows every feature, marked "Full demo" (migration 20261016001600)
  featuredDemo              Boolean          @default(false)
  name                      String
  // The budget items an engagement may use ({ key, label, reportLine }[], DEFAULT_BUDGET_ITEMS in packages/types):
  // the key never changes, so a rename keeps every engagement's lines. The column default is the defaults.
  // The owners' tag types ({ key, label, appliesTo, values: { key, label }[] }[], TagType in packages/types), "Funding
  // source" among them (DEFAULT_TAG_TYPES for a new workspace). Keys never change, so a rename keeps every record's tags.
  tagTypes                  Json             @default("[]")
  // The local part of the workspace's receipts address (`<receiptsAddress>@<RECEIPTS_DOMAIN>`), unique; null until set,
  // then kept: an owner sets it once and nobody changes it through the API (migration 20261015001200).
  receiptsAddress           String?          @unique
  // The owners' setting: an emailed receipt (no person present to say yes) is read with AI when its text does not
  // give everything. Off until an owner turns it on (migration 20261016000400); the platform admin never sets it.
  readEmailedReceiptsWithAi Boolean          @default(false)
  // The terms the owner accepted creating the workspace (TERMS_VERSION in packages/types); null before this was recorded.
  termsVersion              String?
  termsAcceptedAt           DateTime?
  termsAcceptedById         String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  memberships               Membership[]
  engagements               Engagement[]
  documents                 Document[]
  suggestions               Suggestion[]
  importMappings            ImportMapping[]
  inboundReceipts           InboundReceipt[]
  matchRunStats             MatchRunStat[]
}

// Something a member asked for: today, an addition to one of the workspace's lists. Kept so the product can
// learn what the funder forms need; later also sent on.
model Suggestion {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  kind        String // 'list'
  text        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// How a kind of exported transactions file maps to expense lines, saved by name ("QuickBooks mapping") and offered on
// the next import of a file with the same columns. Holds no row of any file (migration 20261015000600).
model ImportMapping {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  headers     String[]  @default([]) // the file's column names
  columns     Json      @default("{}") // ImportColumns in packages/types: which column holds each field
  categories  Json      @default("{}") // category in the file -> budget line name, or 'skip'
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// The queue of emailed receipts (migration 20261015001000): written by the webhook before anyone knows whose it is
// (workspaceId null, trusted work only), then processed by the worker in the API. Holds the envelope, never a file.
model InboundReceipt {
  id               String      @id @default(uuid())
  emailId          String      @unique // the email provider's id
  status           String      @default("received") // INBOUND_RECEIPT_STATUSES in packages/types
  attempts         Int         @default(0)
  nextAttemptAt    DateTime    @default(now())
  error            String? // why the last attempt failed, or which attachments were skipped
  fromAddress      String?
  toAddress        String?
  subject          String?
  receivedAt       DateTime
  workspaceId      String? // set by trusted work with the verified sender; never changes after
  senderUserId     String? // the member who sent it, once verified
  engagementId     String? // where it was filed; cleared when the engagement is deleted (migration 20261015001200)
  documentIds      String[]    @default([])
  filedAttachments String[]    @default([]) // the provider's attachment ids already filed, so a retry files none twice
  rejectReason     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  workspace        Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement       Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, receivedAt])
}

model User {
  id          String       @id // Clerk userId, or `pending-<uuid>` for someone invited who has not signed in
  email       String?      @unique
  displayName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

// Who works in a workspace and as what. Roles: ROLES in packages/types (owner, bookkeeper, auditor). One
// role per person per workspace.
model Membership {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ── Engagements and budgets ─────────────────────────────────────────────────
// One engagement is one thing a workspace accounts for to a funder: a grant, a contract, a cooperative
// agreement. It may start at the proposal (nothing awarded yet) or at the award, so the award fields are
// optional; the workflow (apps/web/src/lib/workflow.ts) reads what is on file.

model Engagement {
  id                     String           @id @default(uuid())
  workspaceId            String
  kind                   String           @default("grant") // ENGAGEMENT_KINDS in packages/types
  name                   String // the program or project, as the team calls it
  funder                 String? // who awards and audits it, e.g. a state workforce board
  funderContact          String? // the funder's contact for this engagement, as written on the award letter
  solicitation           String? // the request for proposals this answered, by name or number
  requestedAmount        Decimal?         @db.Decimal(12, 2)
  proposalSubmittedOn    DateTime?
  awardedOn              DateTime? // the award letter's date
  awardAmount            Decimal?         @db.Decimal(12, 2)
  number                 String? // the funder's contract number, once the contract exists
  // What an emailed receipt's subject names to pick this engagement: capitals, digits and hyphens, unique in the workspace.
  code                   String?
  periodStart            DateTime?
  periodEnd              DateTime?
  tags                   String[]         @default([]) // `<type key>:<value key>`, of the types that apply to engagements
  // Day of the following month the monthly report is due (the form says the 12th); a month can override it.
  reportDueDay           Int              @default(12)
  // The contract's indirect-cost terms in words (rate, base, or "none"), so the indirect-as-direct check is a
  // rule and not a guess.
  indirectTerms          String?
  // Reporting, as the funder's form names it: who the report is submitted to and how, and who signs it
  // (prepared by, authorized by). The same people sign the letter to the auditors.
  reportTo               String?
  submissionMethod       String?
  preparerName           String?
  preparerOrganization   String?
  authorizerName         String?
  authorizerOrganization String?
  // The items a participant's file must hold for this program ({ key, label, required }[]); empty means the
  // defaults in packages/types (ELIGIBILITY_ITEMS).
  eligibilityItems       Json             @default("[]")
  status                 String           @default("proposed") // ENGAGEMENT_STATUSES in packages/types
  // The records kept besides the financials (ENGAGEMENT_TRACKS); a step left out is not used.
  tracks                 String[]         @default(["proposal", "award-letter", "contract"])
  // Records that do not exist for this engagement, with the reason, keyed by document kind (e.g. no award
  // letter because the funder sent the contract directly). A documented absence is a record the audit accepts.
  waivers                Json             @default("{}")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  workspace              Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  budgetLines            BudgetLine[]
  monthlyReports         MonthlyReport[]
  expenses               Expense[]
  participants           Participant[]
  documents              Document[]
  inboundReceipts        InboundReceipt[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, code])
  @@index([workspaceId])
}

// One line of an engagement's approved budget: its name, the line of the funder's monthly report it is on, its
// approved amount and a note. Every expense is spent against one (Expense.budgetLineId).
model BudgetLine {
  id           String     @id @default(uuid())
  workspaceId  String? // set by trigger
  engagementId String
  name         String // the line as the contract's approved budget names it
  reportLine   String // REPORT_LINES
  amount       Decimal    @db.Decimal(12, 2)
  narrative    String?
  sortOrder    Int        @default(0)
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@index([workspaceId])
}

// ── Monthly reports and expenses ────────────────────────────────────────────

model MonthlyReport {
  id                    String            @id @default(uuid())
  workspaceId           String? // set by trigger
  engagementId          String
  period                String // 'YYYY-MM', the month the expenses belong to
  status                String            @default("draft") // REPORT_STATUSES: draft, closed, submitted
  dueDate               DateTime
  submittedAt           DateTime?
  preparedByName        String?
  // Who approved the month-end closing for the company, and on what day (they sign the form as "Authorized by").
  // The bookkeeper records it; the approver is often not a user.
  authorizedByName      String?
  authorizedAt          DateTime?
  comments              String?
  closingNote           String?
  sentBackReason        String? // why the month-end closing was last sent back
  sentBackAt            DateTime? // when, and by whom (staff email): who pressed Send back, or who changed the budget
  sentBackByEmail       String?
  editsRequestedAt      DateTime? // edits asked for on a draft month, before its closing is approved
  editsRequestedByEmail String?
  editsRequestComment   String?
  isFinal               Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  engagement            Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  expenses              Expense[]
  wexPayments           WexPayment[]
  checks                Check[]
  reopenings            ReportReopening[]
  payrollMatchRuns      PayrollMatchRun[]

  @@unique([engagementId, period])
  @@index([workspaceId])
  @@index([workspaceId, status, dueDate])
}

// A submitted month reopened to correct it (migration 20261015001500), kept for good: when, by whom and why, and
// what it undid (the submission, the month-end closing approval, the signed copy that went to the funder).
// Append-only: members read and add one in their own name; it goes only with its month.
// "Match payroll & timecards" (migration 20261016001000): a payroll zip staged while its matches are checked. Nothing
// in the month changes until Save; discard or 24 hours removes the run, its files and their stored objects.
model PayrollMatchRun {
  id              String             @id @default(uuid())
  workspaceId     String? // set by trigger
  monthlyReportId String
  createdById     String
  createdAt       DateTime           @default(now())
  replace         Boolean            @default(false)
  monthlyReport   MonthlyReport      @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  files           PayrollMatchFile[]

  @@index([monthlyReportId])
  @@index([workspaceId, createdAt])
}

model PayrollMatchFile {
  id          String          @id @default(uuid())
  workspaceId String? // set by trigger
  runId       String
  // A document already on file (a plain id); null for a file staged by this run.
  documentId  String?
  kind        String
  sensitivity String
  fileName    String
  contentType String
  size        Int
  sha256      String
  storageKey  String
  pages       Int             @default(0)
  scanned     Boolean         @default(false)
  /// [{ page, text, x, y, width, height }] in PDF points: the file's own text, personal on a pay stub
  lines       Json            @default("[]")
  /// The text runs with their boxes: [{ page, str, x, y, w, h }]; a highlight is cut from them
  items       Json            @default("[]")
  // Read by the background job (migration 20261016001300): waiting, reading, read or failed.
  status      String          @default("waiting")
  attempts    Int             @default(0)
  leaseUntil  DateTime?
  error       String?
  // How long the job took to read it (migration 20261016001500).
  readMs      Int?
  // Which storage holds its object, 'r2:<bucket>' or 'local:<host>'; the job claims only its own (migration
  // 20261016001700). Null on a file staged before it.
  storage     String?
  createdAt   DateTime        @default(now())
  run         PayrollMatchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([workspaceId])
  @@index([status, leaseUntil])
}

// One finished match run, for Admin tools → Matching statistics (migration 20261016001500): counts, sizes and
// durations only, never a file name, a name, an amount or a record's id. Append-only.
model MatchRunStat {
  id             String    @id @default(uuid())
  workspaceId    String
  feature        String // 'payroll' | 'receipts' | 'emailed-receipts'
  // A plain id, as DataAccessLog.actorId, and the email staff are named by.
  startedById    String
  startedByEmail String
  startedAt      DateTime
  finishedAt     DateTime  @default(now())
  outcome        String // payroll: saved | discarded | expired; receipts: done | failed
  fileCount      Int       @default(0)
  totalBytes     BigInt    @default(0)
  readMs         Int?
  durationMs     Int       @default(0)
  items          Int       @default(0)
  matched        Int       @default(0)
  guessed        Int       @default(0)
  missing        Int       @default(0)
  failed         Int       @default(0)
  bankLines      Int       @default(0)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([finishedAt])
  @@index([workspaceId, finishedAt])
}

model ReportReopening {
  id               String        @id @default(uuid())
  workspaceId      String? // set by trigger
  monthlyReportId  String
  reopenedAt       DateTime      @default(now())
  // A plain id, as DataAccessLog.actorId: the history outlives the person; the email is kept with it.
  reopenedById     String
  reopenedByEmail  String
  reason           String // at most 500 characters
  submittedAt      DateTime // the submission this reopening undid
  approvedByName   String?
  approvedAt       DateTime?
  // The signed copy on file for that submission, a plain id; the API never replaces or removes it.
  signedDocumentId String?
  monthlyReport    MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)

  @@index([monthlyReportId, reopenedAt])
  @@index([workspaceId])
}

// One row per expense per report line. A shared cost split between two lines is two rows with one item number.
model Expense {
  id                String            @id @default(uuid())
  workspaceId       String? // set by trigger
  engagementId      String
  monthlyReportId   String
  itemNumber        String // the team's own numbering, e.g. 'ISY-12'
  date              DateTime
  vendor            String
  memo              String?
  account           String? // the general-ledger account, as text
  totalCost         Decimal           @db.Decimal(12, 2)
  allocatedAmount   Decimal           @db.Decimal(12, 2) // the program's share charged to this line
  allocationType    String            @default("direct") // ALLOCATION_TYPES
  allocationNote    String? // e.g. '32.84% of payroll hours in January'
  reportLine        String // REPORT_LINES; follows the budget line when there is one (trigger Expense_4_budget_line)
  budgetLineId      String? // the engagement's budget line it is spent against; null until a person chooses
  budgetLine        BudgetLine?       @relation(fields: [budgetLineId], references: [id], onDelete: NoAction)
  tags              String[]          @default([]) // `<type key>:<value key>`, from Workspace.tagTypes
  // The hash of the imported file row this came from (date, amount, payee, memo, reference); null when typed.
  importFingerprint String?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  engagement        Engagement        @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  monthlyReport     MonthlyReport     @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  documents         ExpenseDocument[]
  checks            Check[]

  @@unique([engagementId, itemNumber, reportLine])
  @@unique([engagementId, importFingerprint])
  @@index([workspaceId])
  @@index([monthlyReportId])
  @@index([budgetLineId])
}

// ── Documents ───────────────────────────────────────────────────────────────
// Private objects. The row holds the key; a short-lived signed URL is made on demand and the read is logged.
// `sensitivity` is 'financial' (invoices, statements, registers, allocation sheets) or 'personal' (eligibility
// records, enrollment forms, pay stubs), which sets how it may be served (CLAUDE.md, "Data rules").

model Document {
  id               String                @id @default(uuid())
  workspaceId      String
  engagementId     String?
  kind             String // DOCUMENT_KINDS
  sensitivity      String                @default("financial") // 'financial' | 'personal'
  fileName         String
  contentType      String
  size             Int
  sha256           String
  storageKey       String                @unique
  period           String? // 'YYYY-MM' when the document belongs to one month (a statement, a register)
  uploadedById     String
  uploadedAt       DateTime              @default(now())
  // What was read from a receipt or invoice (financial only; never a personal document) and by what:
  // 'text' (the PDF's own text), 'ai', or 'person'. Dismissed: "not for this grant", out of the unmatched list.
  receiptAmount    Decimal?              @db.Decimal(12, 2)
  receiptDate      DateTime?             @db.Date
  receiptVendor    String?
  receiptReadBy    String?
  receiptDismissed Boolean               @default(false)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  engagement       Engagement?           @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  expenses         ExpenseDocument[]
  participants     ParticipantDocument[]
  wexPayments      WexPaymentDocument[]

  @@index([workspaceId, period])
  @@index([engagementId])
}

model ExpenseDocument {
  expenseId   String
  documentId  String
  purpose     String // DOCUMENT_PURPOSES
  /// The statement line marked as this item's payment: { page, x, y, width, height, text? } in PDF points (migration 20261015000800)
  mark        Json?
  /// The exact words highlighted on this proof for this item: [{ page, x, y, width, height, text }] (migration 20261016001400)
  marks       Json     @default("[]")
  workspaceId String? // set by trigger
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([expenseId, documentId])
  @@index([documentId])
  @@index([workspaceId])
}

// ── Participants and work experience (WEX) ──────────────────────────────────
// A participant's eligibility file is in scope (the monitoring review asks for it) and is the most sensitive
// data here: its documents carry sensitivity 'personal'. ParticipantDocument.purpose names which item of the
// funder's eligibility checklist the document satisfies (ELIGIBILITY_ITEMS in packages/types).

model Participant {
  id               String                @id @default(uuid())
  workspaceId      String? // set by trigger
  engagementId     String
  participantId    String // the funder's participant id
  displayName      String
  enrollmentStatus String                @default("new") // 'new' | 'carryover'
  currentStatus    String                @default("active") // 'active' | 'offboarded' | 'carry-over'
  tags             String[]              @default([]) // personal data: logged by field name only
  enrolledAt       DateTime?
  exitedAt         DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  engagement       Engagement            @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  documents        ParticipantDocument[]
  wexPayments      WexPayment[]

  @@unique([engagementId, participantId])
  @@index([workspaceId])
}

model ParticipantDocument {
  participantId String
  documentId    String
  purpose       String // ELIGIBILITY_ITEMS
  workspaceId   String? // set by trigger
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([participantId, documentId])
  @@index([documentId])
  @@index([workspaceId])
}

model WexPayment {
  id              String               @id @default(uuid())
  workspaceId     String? // set by trigger
  monthlyReportId String
  participantId   String
  payPeriodStart  DateTime
  payPeriodEnd    DateTime
  hours           Decimal?             @db.Decimal(8, 2)
  grossAmount     Decimal              @db.Decimal(12, 2)
  tags            String[]             @default([])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  monthlyReport   MonthlyReport        @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  participant     Participant          @relation(fields: [participantId], references: [id], onDelete: Restrict)
  documents       WexPaymentDocument[]
  checks          Check[]

  @@index([workspaceId])
  @@index([monthlyReportId])
  @@index([participantId])
}

model WexPaymentDocument {
  wexPaymentId String
  documentId   String
  purpose      String // 'timesheet' | 'register' | 'payment' (the paystub or deposit advice)
  /// As ExpenseDocument.mark: the bank statement line this payment was paid on
  mark         Json?
  /// As ExpenseDocument.marks
  marks        Json       @default("[]")
  workspaceId  String? // set by trigger
  wexPayment   WexPayment @relation(fields: [wexPaymentId], references: [id], onDelete: Cascade)
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([wexPaymentId, documentId])
  @@index([documentId])
  @@index([workspaceId])
}

// ── Checks ──────────────────────────────────────────────────────────────────
// A finding on a report, an expense or a WEX payment. Rules write them on every save; AI review (phase 2)
// writes them with source 'ai'. A blocker stops submission until resolved.

model Check {
  id              String        @id @default(uuid())
  workspaceId     String? // set by trigger
  monthlyReportId String
  expenseId       String?
  wexPaymentId    String?
  participantId   String? // a finding about a participant's file; not a relation, the participant may go
  code            String // CHECK_CODES
  severity        String // 'blocker' | 'attention' | 'info'
  source          String        @default("rule") // 'rule' | 'ai'
  message         String
  status          String        @default("open") // 'open' | 'resolved' | 'waived'
  resolvedById    String?
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime      @default(now())
  monthlyReport   MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  expense         Expense?      @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  wexPayment      WexPayment?   @relation(fields: [wexPaymentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([monthlyReportId, status])
  @@index([expenseId])
}

// ── Access log ──────────────────────────────────────────────────────────────
// Every read, list, download and export of a document or participant row, and every change to the workspace's
// data. Written by the API in the caller's own context, a change in the same transaction as the change itself
// (AccessLogService.change); readable inside the workspace; never updated or deleted by the API.

model DataAccessLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorId     String
  actorName   String
  resource    String // 'workspace' | 'engagement' | 'document' | 'expense' | 'report' | 'participant' | 'export'
  subjectId   String?
  action      String // 'read' | 'list' | 'download' | 'create' | 'update' | 'delete' | 'export'
  detail      String? // short, non-sensitive context; lines before 20261013000100 only
  description String? // what the person did, in the screen's words; never a personal value
  changes     Json? // [{ field, before?, after? }]; a personal field is its name alone, see src/core/changes.ts
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}

// ── Terms ───────────────────────────────────────────────────────────────────
// A person accepting the Terms, at first sign-in and again whenever their wording (its fingerprint) changes.
// Append-only and one row per person per fingerprint. No foreign key: it outlives the User row. See migration
// 20261012000300; a person reads and inserts only their own rows.

model TermsAcceptance {
  id          String   @id @default(uuid())
  userId      String
  fingerprint String // the Terms' version: the hash of their wording, see src/auth/terms-fingerprint.ts
  acceptedAt  DateTime @default(now())

  @@unique([userId, fingerprint])
}

// ── Deletion ────────────────────────────────────────────────────────────────
// The record of an owner deleting an engagement (or, with engagementId null, a workspace's own documents and the
// workspace). Made when the full export starts, 'downloaded' only when the response finished, 'deleted' when the
// delete ran. It has no foreign keys on purpose: it outlives the rows it describes. The retained copy is the object
// at exportKey, under the top-level `retained/` prefix that one R2 lifecycle rule expires after 30 days (it is not a
// Document). Owners write it; nobody reads or deletes it through the API.

// Who made or unmade a platform admin (Clerk publicMetadata.role), one row per attempt that reached Clerk: kept or
// failed. Append-only, no workspace and no foreign keys; only the platform admin's database flag reads or adds to it
// (migration 20261013000200).
model PlatformRoleChange {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  actorId     String
  actorEmail  String?
  targetId    String
  targetEmail String?
  oldRole     String?
  newRole     String?
  outcome     String // 'done' | 'failed'
  error       String?

  @@index([at])
}

model DeletionRecord {
  id            String    @id @default(uuid())
  workspaceId   String
  engagementId  String?
  subjectName   String
  deletedById   String
  deletedByName String
  status        String    @default("exported") // 'exported' | 'downloaded' | 'deleted'
  exportKey     String
  sha256        String    @default("")
  bytes         Int       @default(0)
  parts         Json      @default("[]") // one entry per zip of the export, see migration 20261012000200
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  expiresAt     DateTime

  @@index([workspaceId, engagementId])
}

// What is highlighted on each payroll proof type, set by a platform admin (migration 20261016001400). Append-only:
// the newest row per kind is in force; a kind with none uses DEFAULT_HIGHLIGHTS. No workspace.
model HighlightSetting {
  id             String   @id @default(uuid())
  kind           String
  fields         String[]
  changedById    String
  changedByEmail String?
  changedAt      DateTime @default(now())

  @@index([kind, changedAt])
}

// ── Health ──────────────────────────────────────────────────────────────────
// Failures people hit through no fault of their own, counted by the public /api/health/upload-failures and
// /api/health/server-errors checks (src/core/service-failure-log.ts). When, which kind and the route pattern only: no
// workspace, person, file name or error message, so not a tenant table. See migration 20261016000100.

model ServiceFailure {
  id    String   @id @default(uuid())
  at    DateTime @default(now())
  kind  String // 'upload' | 'server'
  route String // method and route pattern, such as 'POST /api/documents'

  @@index([kind, at])
}
